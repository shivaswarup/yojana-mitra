rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 120 &&
             (!('age' in data) || data.age is number) &&
             (!('gender' in data) || (data.gender in ['male', 'female', 'other', 'all'])) &&
             (!('state' in data) || (data.state is string && data.state.size() <= 100)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('areaType' in data) || (data.areaType in ['Rural', 'Urban'])) &&
             (!('maritalStatus' in data) || (data.maritalStatus in ['Single', 'Married', 'Widowed', 'Divorced'])) &&
             (!('highestEducation' in data) || (data.highestEducation is string && data.highestEducation.size() <= 100)) &&
             (!('currentEducationStatus' in data) || (data.currentEducationStatus in ['Pursuing', 'Completed', 'Dropped Out'])) &&
             (!('category' in data) || (data.category in ['General', 'OBC', 'SC', 'ST', 'EWS', 'Minority'])) &&
             (!('annualFamilyIncome' in data) || data.annualFamilyIncome is number) &&
             (!('employmentStatus' in data) || (data.employmentStatus is string && data.employmentStatus.size() <= 100)) &&
             (!('occupation' in data) || (data.occupation is string && data.occupation.size() <= 150)) &&
             (!('isFarmer' in data) || data.isFarmer is bool) &&
             (!('isBusinessOwner' in data) || data.isBusinessOwner is bool) &&
             (!('isWomanEntrepreneur' in data) || data.isWomanEntrepreneur is bool) &&
             (!('isSeniorCitizen' in data) || data.isSeniorCitizen is bool) &&
             (!('isBPLOrEWS' in data) || data.isBPLOrEWS is bool) &&
             (!('isDisability' in data) || data.isDisability is bool) &&
             (!('isMinority' in data) || data.isMinority is bool) &&
             (!('isStudent' in data) || data.isStudent is bool);
    }

    // Validation helper for AppliedSchemeRecord
    function isValidAppliedScheme(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.schemeId is string && data.schemeId.size() <= 128 &&
             data.schemeName is string && data.schemeName.size() <= 250 &&
             data.status in ['Not Applied', 'Applied', 'Under Review', 'Approved', 'Rejected'] &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('applicationReferenceNumber' in data) || (data.applicationReferenceNumber is string && data.applicationReferenceNumber.size() <= 100)) &&
             (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 100)) &&
             (!('officialWebsite' in data) || (data.officialWebsite is string && data.officialWebsite.size() <= 500));
    }

    // Validation helper for NotificationItem
    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.type in ['deadline', 'new_scheme', 'status_update', 'eligibility'] &&
             data.read is bool &&
             (!('schemeId' in data) || (data.schemeId is string && data.schemeId.size() <= 128));
    }

    // User Profile Master Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Tracked Applications subcollection
      match /appliedSchemes/{applicationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(applicationId) && isValidAppliedScheme(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(applicationId) && isValidAppliedScheme(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(applicationId);
      }

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(notificationId) && isValidNotification(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(notificationId) && isValidNotification(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(notificationId);
      }
    }
  }
}
